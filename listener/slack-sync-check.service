[Unit]
Description=Run Slack hook and listener sync checks (slack-sync-check-run.sh, 5-minute timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/hatch/workspace/slack-listener
Environment="HOME=/home/hatch"
# slackcli is a Bun binary: without NODE_USE_ENV_PROXY it ignores the
# proxy variables, tries direct TLS, and hangs retrying against the
# intercepting egress proxy. Yanayana hit this on 2026-11-18; the same
# line is required here because a systemd service starts with a clean
# environment (the agent shell has NODE_USE_ENV_PROXY=1, systemd does not).
Environment="NODE_USE_ENV_PROXY=1"
Environment="HTTP_PROXY=http://hatch-egress-proxy:3128"
Environment="HTTPS_PROXY=http://hatch-egress-proxy:3128"
Environment="ALL_PROXY=http://hatch-egress-proxy:3128"
Environment="http_proxy=http://hatch-egress-proxy:3128"
Environment="https_proxy=http://hatch-egress-proxy:3128"
Environment="all_proxy=http://hatch-egress-proxy:3128"
Environment="NO_PROXY=localhost,127.0.0.1,::1"
Environment="no_proxy=localhost,127.0.0.1,::1"
Environment="SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem"
Environment="REQUESTS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem"
Environment="CURL_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem"
TimeoutStartSec=300
ExecStart=/bin/bash /home/hatch/workspace/neiro-slack-system/hooks/scripts/slack-sync-check-gate.sh
